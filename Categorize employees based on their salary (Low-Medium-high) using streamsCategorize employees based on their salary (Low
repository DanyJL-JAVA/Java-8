        List<SalaryVo> arrlst = Arrays.asList(new SalaryVo(23000, "santhosh", 9077, LocalDate.of(2004, 9, 9), "chennai"),
                new SalaryVo(41, "ram", 91032, LocalDate.of(2003, 9, 12), "chennai"),
                new SalaryVo(81, "fazil", 51600, LocalDate.of(2019, 2, 9), "kerala"),
                new SalaryVo(19, "hari", 100000, LocalDate.of(2015, 10, 2), "chennai"),
                new SalaryVo(16, "jamal", 82100, LocalDate.of(2003, 02, 8), "chennai")
        );


        Map<Range, List<SalaryVo>> hashmap = arrlst.stream().collect(Collectors.groupingBy(a -> {

                    if (a.getSalary() < 50000) return Range.LOW;
                    if (a.getSalary() >= 100000) return Range.HIGH;
                    else return Range.MEDIUM;


                }

        ));


        hashmap.entrySet().stream().forEach(a -> {

            System.out.println(a.getKey() +"----------------->");

            a.getValue().forEach(b -> {

                System.out.println(b.getEName() + "<=>" + b.getSalary());


            });

        });

