public class Main {

	public static void main(String[] args) {

		Main obj = new Main();

		String s = "The quick, brown fox jumped over the lazy  dog!";

		Arrays.stream(s.split("\\s+")).map(a -> a.toLowerCase().replaceAll("[^a-z\\s+]", ""))
				.forEach(System.out::println);
		System.out.println("-------------------------------------------------- \n");

		String result = Arrays.stream(s.split("\\s+")).map(a -> a.replaceAll("[^a-z\\s+]", ""))
				.max(Comparator.comparingInt(String::length)).get();

		System.out.println("Answer =" + result); // OUTPUT : jumped

	}

	// Note : to Avoid Optional tag Straight forward ways use on -> .orElse() or
