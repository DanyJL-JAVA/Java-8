public class Main {


    @FunctionalInterface
    public interface AddAll{


        int addIt(int a, int b);

    }

@FunctionalInterface
    public interface CheckAll{


        boolean checkIt(String s);

    }


    public static void main(String[] args) {

        // Custom Functional Interface.

        // AddAll
        AddAll ad = (a,b) -> a + b;

        System.out.println(ad.addIt(8,9)); // 17


        // CheckAll

        CheckAll ch = (a) -> a.length() == 3;

        System.out.println(ch.checkIt("all")); // true


    }

}
