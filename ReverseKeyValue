public class Main {

	public static void main(String[] args) {

		Map<Integer, String> hashmap = Map.of(4, "thursday", 2, "tuesday", 7, "sunday", 5, "friday", 1, "monday", 6,
				"saturday", 3, "wednesday");

		// Comparing With key // ASC Order

		Map<Integer, String> hash = hashmap.entrySet().stream()
				.sorted(Map.Entry.comparingByKey(Comparator.naturalOrder()))
				.collect(Collectors.toMap(Map.Entry::getKey, Map.Entry::getValue, (a, b) -> a, LinkedHashMap::new));

		System.out.println("Comparing key [Asc] =>" + hash); // OUTPUT : {1=monday,
		// 2=tuesday, 3=wednesday, 4=thursday,
		// 5=friday, 6=saturday,
		// 7=sunday}

